# QPlus Capital – example environment configuration
# This file IS committed and contains placeholders ONLY (no real values).
# Copy it to `.env` and fill in the real values there.
# `.env` itself is gitignored and must NEVER be committed.
#
# Whenever real credentials are created, also store them in the shared
# password manager so both teammates can find them again.

# The live MT5 bridge attaches to already-running, logged-in terminals. Each account's
# login identity and machine-specific terminal path are required here so the runner can
# attach to the intended instance and refuse a mismatching account. Replace every
# placeholder before using a live-facing command; placeholders fail closed.
#
# Windows rule for uv's dotenv parser: keep values in single quotes. Backslash paths
# fail when unquoted or double-quoted; forward slashes are also safe.
MT5_MEX_LOGIN='<broker-account-login>'
MT5_MEX_TERMINAL_PATH='<absolute-path-to-terminal64.exe>'
MT5_TTP_LOGIN='<broker-account-login>'
MT5_TTP_TERMINAL_PATH='<absolute-path-to-terminal64.exe>'

# Optional: Telegram push notifications for live trade signals / safety halts.
# Leave blank to disable (the runner still logs + beeps). Token from @BotFather,
# chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
