# QPlus Capital – example environment configuration
# This file IS committed and contains placeholders ONLY (no real values).
# Copy it to `.env` and fill in the real values there.
# `.env` itself is gitignored and must NEVER be committed.
#
# Whenever real credentials are created, also store them in the shared
# password manager so both teammates can find them again.

# The live MT5 bridge needs NO broker credentials in code: it attaches to an
# already-running, logged-in MetaTrader 5 terminal. So there is normally nothing here.

# Optional: Telegram push notifications for live trade signals / safety halts.
# Leave blank to disable (the runner still logs + beeps). Token from @BotFather,
# chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
